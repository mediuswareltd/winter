# Claude API key (https://console.anthropic.com). Without it, answers come from a local Ollama model
# if one is running, otherwise the app shows the retrieved passages.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# VIDEORAG_DATA_DIR=data
# VIDEORAG_WHISPER_MODEL=base            # tiny | base | small | medium | large-v3
# VIDEORAG_WHISPER_DEVICE=auto           # auto | cpu | cuda
# VIDEORAG_TEXT_MODEL=BAAI/bge-small-en-v1.5
# VIDEORAG_CLIP_MODEL=clip-ViT-B-32
# VIDEORAG_CHUNK_SECONDS=45
# VIDEORAG_CHUNK_OVERLAP=10
# VIDEORAG_SCENE_THRESHOLD=0.35
# VIDEORAG_MAX_FRAME_GAP=20
# VIDEORAG_CLAUDE_MODEL=claude-opus-5-5
# VIDEORAG_CLAUDE_EFFORT=medium          # low | medium | high
# VIDEORAG_IMAGES_PER_ANSWER=4
# VIDEORAG_LLM=auto                      # auto | claude | ollama | none
# VIDEORAG_OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_HOST=http://127.0.0.1:11434
# WINTER_PORT=8000                      # host port for docker compose
